# ==============================================================================
# SafeMine AI Mobile (Expo / React Native) — Configuración de Red LAN
# ==============================================================================
# Reemplaza 192.168.1.100 por la IP WiFi local de tu computadora donde corre
# FastAPI (`uvicorn app.main:app --host 0.0.0.0 --port 8000`).
# Si no se define, la app autodetecta la IP LAN desde el host de Expo Go.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

