# ============================================================================
# SafeMine AI - Configuración de Entorno (Backend FastAPI)
# ============================================================================

# 1. Base de Datos (SQLite local por defecto; descomentar PostgreSQL para AWS RDS)
DATABASE_URL=sqlite:///./safemine.db
# DATABASE_URL=postgresql://postgres:tu_password@safemine-rds.xxxx.us-east-1.rds.amazonaws.com:5432/safemine

# 2. Seguridad y Sesión
JWT_SECRET_KEY=safemine-super-secret-key-2026

# 3. Interruptores de Simulación (Mock vs. Producción en la Nube)
# Pon en "false" cuando hayas colocado tus llaves reales abajo
USE_MOCK_AI=true
USE_MOCK_AWS=true

# 4. Google Gemini API (Validación de Constancias Médicas - SDK google-genai)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash

# 5. AWS Rekognition (Detección de EPPs en Tiempo Real) y AWS S3 (Documentos)
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=safemine-documents-bucket
MIN_EPP_CONFIDENCE=80.0
